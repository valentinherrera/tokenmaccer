        }
      }
    },
    "Other participants see your display name, your GitHub username and these totals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Teilnehmende sehen deinen Anzeigenamen, deinen GitHub-Benutzernamen und diese Summen."
