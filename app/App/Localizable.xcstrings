    },
    "Others see your display name, your GitHub username and these totals. Leave at any time, and your account and totals are deleted from the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere sehen deinen Anzeigenamen, deinen GitHub-Benutzernamen und diese Summen. Du kannst jederzeit austreten, dann werden dein Konto und deine Summen vom Server gelöscht."
          }
        }
      }
    },
