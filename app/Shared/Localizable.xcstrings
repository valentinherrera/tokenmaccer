        }
      }
    },
    "You're offline. Your place updates when you're back online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Dein Platz aktualisiert sich, sobald du wieder online bist."
