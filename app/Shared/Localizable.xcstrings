    },
    "Your account on the leaderboard server could not be deleted (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto auf dem Leaderboard-Server konnte nicht gelöscht werden (%@)."
          }
        }
      }
    },
    "Your account, your profile and all reported totals are deleted from the leaderboard server, and the sign-in is removed from this Mac. Your history on this Mac stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto, dein Profil und alle gemeldeten Summen werden auf dem Leaderboard-Server gelöscht, und die Anmeldung wird von diesem Mac entfernt. Dein Verlauf auf diesem Mac bleibt."
          }
        }
      }
    },
    "Your display name will be your GitHub username; you can change it right after." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Anzeigename wird dein GitHub-Benutzername; du kannst ihn gleich danach ändern."
          }
        }
      }
    },
    "Your leaderboard entry no longer exists. Join again to take part." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Leaderboard-Eintrag existiert nicht mehr. Tritt erneut bei, um mitzumachen."
          }
        }
      }
    },
    "Your place among Claude Code users, or in one of your groups: the top places and your own row." : {
      "localizations" : {
