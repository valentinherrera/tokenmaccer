    "Leave and Delete" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Austreten und löschen"
          }
        }
      }
    },
    "Leave at any time: your account, your profile and all reported totals are deleted from the server. Only your GitHub user ID and the time of your last report stay a little longer (removed with the first report the server receives once they are an hour old), so leaving and joining again cannot get around the report limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit austreten: Dein Konto, dein Profil und alle gemeldeten Summen werden vom Server gelöscht. Nur deine GitHub-Nutzer-ID und der Zeitpunkt deiner letzten Meldung bleiben etwas länger (entfernt mit der ersten Meldung, die der Server erhält, sobald sie eine Stunde alt sind), damit Austreten und erneutes Beitreten die Meldegrenze nicht umgehen."
          }
        }
      }
    },
    "Leave the leaderboard?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaderboard verlassen?"
          }
        }
      }
    },
