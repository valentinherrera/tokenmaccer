    "You were invited to a group on the TokenMaccer leaderboard. Its members see your display name, your GitHub username and your totals on the group's ranking, as on the global leaderboard. You can leave the group at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wurdest in eine Gruppe im TokenMaccer-Leaderboard eingeladen. Ihre Mitglieder sehen deinen Anzeigenamen, deinen GitHub-Nutzernamen und deine Summen in der Rangliste der Gruppe, wie im globalen Leaderboard. Du kannst die Gruppe jederzeit verlassen."
          }
        }
      }
    },
    "You're in “%@”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist in „%@“"
          }
        }
      }
    },
    "You're in. Your place appears after the first report." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist dabei. Dein Platz erscheint nach der ersten Meldung."
