        }
      }
    },
    "You're no longer in this group" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist nicht mehr in dieser Gruppe"
          }
        }
      }
    },
    "You're not in a group yet." : {
