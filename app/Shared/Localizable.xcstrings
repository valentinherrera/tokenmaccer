          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Platz unter den Nutzerinnen und Nutzern von Claude Code oder in einer deiner Gruppen: die vorderen Plätze und deine eigene Zeile."
          }
        }
      }
    },
    "Your profile and totals are deleted, but your account on the leaderboard server is not yet (%@)." : {
