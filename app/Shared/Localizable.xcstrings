          }
        }
      }
    },
    "Join the leaderboard to compare your totals with other Claude Code users. Only your period totals are shared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt dem Leaderboard bei, um deine Summen mit anderen Claude-Code-Nutzern zu vergleichen. Geteilt werden nur deine Summen je Zeitraum."
